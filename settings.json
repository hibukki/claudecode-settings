{
  "cleanupPeriodDays": 36500,
  "env": {
    "PNPM_HOME": "/Users/yonatancale/Library/pnpm",
    "CLAUDE_CODE_ENABLE_TASKS": "1",
    "CLAUDE_CODE_ADDITIONAL_DIRECTORIES_CLAUDE_MD": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "EDITOR": "code -w",
    "CLAUDE_CODE_PLAN_V2_EXPLORE_AGENT_COUNT": "3",
    "ENABLE_TOOL_SEARCH": "true",
    "BASH_MAX_TIMEOUT_MS": "172800000"
  },
  "permissions": {
    "allow": [
      "Read(/Users/yonatancale/.claude/*)",
      "Read(/Users/yonatancale/Development/dotfiles/*)",
      "Read(/Users/yonatancale/.config/kitty/*)",
      "Read(/Users/yonatancale/.hammerspoon/init.lua)",
      "Glob(~/.config/**/*kitty*)",
      "Glob(~/Development/dotfiles/**)",
      "Grep(~/Development/dotfiles/**)",
      "Skill(plugin-dev:create-plugin)",
      "Skill(plugin-dev:agent-development)",
      "Skill(plugin-dev:hook-development)",
      "mcp__plugin_context7_context7",
      "WebFetch",
      "WebSearch",
      "Bash(Precis:*)",
      "Bash(Precis *)"
    ],
    "deny": [],
    "ask": [],
    "defaultMode": "auto",
    "additionalDirectories": []
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/yonatancale/.config/iterm2/cc-status"
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/yonatancale/.claude/hooks/after-compact-reorient.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/yonatancale/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/yonatancale/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/yonatancale/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/yonatancale/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/yonatancale/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/yonatancale/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/yonatancale/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/yonatancale/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/yonatancale/.config/iterm2/cc-status"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "/Users/yonatancale/.claude/statusline-minimal.py"
  },
  "footerLinksRegexes": [
    {
      "type": "regex",
      "pattern": "claude\\.ai/artifact/(?<short>[\\w-]{4})(?<rest>[\\w-]*)",
      "url": "https://claude.ai/artifact/{short}{rest}",
      "label": "A:{short}"
    },
    {
      "type": "regex",
      "pattern": "claude\\.ai/code/artifact/(?<short>[\\w-]{4})(?<rest>[\\w-]*)",
      "url": "https://claude.ai/code/artifact/{short}{rest}",
      "label": "A:{short}"
    }
  ],
  "enabledPlugins": {
    "hookify@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "mats@alignment-hive": false,
    "code-simplifier@claude-plugins-official": true,
    "google-workspace-connector@yonatans-cc-marketplace": true,
    "document-skills@anthropic-agent-skills": true,
    "data@knowledge-work-plugins": false,
    "cowork-plugin-management@knowledge-work-plugins": true,
    "hive@alignment-hive": false,
    "telegram@claude-plugins-official": false,
    "precis@precis": true,
    "quick-review@yonatans-cc-marketplace": true,
    "google-docs@hibukki-mcp": true,
    "notion@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "cc-plugin-you-should-know@builtin": true
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "hibukki-mcp": {
      "source": {
        "source": "github",
        "repo": "hibukki/docs_mcp"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "high"
    }
  },
  "awaySummaryEnabled": false,
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "showThinkingSummaries": true,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "verbose": true,
  "autoCompactEnabled": true,
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "allow": [
      "Creating artifacts"
    ],
    "soft_deny": [],
    "environment": [
      "Source control: github.com/hibukki"
    ]
  },
  "voiceEnabled": true
}
